DATABASE_URL="postgresql://postgresuser:password@db:5432/postgres?schema=public"
POSTGRES_USER="postgresuser"
POSTGRES_PASSWORD="password"
POSTGRES_DB="postgres"
OPENAI_API_KEY="replace-with-your-openai-api-key"
# Optional: defaults to gpt-5.6-terra. For example, use gpt-5.6-luna for a lower-cost model.
OPENAI_MODEL="gpt-5.6-terra"
# Optional: defaults to low. Options: none, low, medium, high, xhigh, max.
# Try gpt-5.6-luna with high, xhigh, or max if you want to trade more latency and cost for stronger reasoning.
OPENAI_REASONING_EFFORT="low"
