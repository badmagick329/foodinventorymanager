DATABASE_URL="postgresql://postgresuser:password@db:5432/postgres?schema=public"
POSTGRES_USER="postgresuser"
POSTGRES_PASSWORD="password"
POSTGRES_DB="postgres"
OPENAI_API_KEY="replace-with-your-openai-api-key"
# Optional: defaults to gpt-6-luna.
OPENAI_MODEL="gpt-6-luna"
# Optional: defaults to low. Options: none, low, medium, high, xhigh, max.
OPENAI_REASONING_EFFORT="low"
# Optional cost overrides in USD per million tokens. Defaults are built in for gpt-5.6-terra, gpt-5.6-luna, and gpt-6-luna.
# Set all three only when using another model or when pricing changes. Leave unset to use the model-specific rate.
