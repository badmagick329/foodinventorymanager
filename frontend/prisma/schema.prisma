// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Food {
  id      Int             @id @default(autoincrement())
  name    String
  amount  Float
  unit    MeasurementUnit
  expiry  String?
  storage StorageType
}

// A snapshot of a quantity removed from live inventory. For a full deletion,
// this is the item's full quantity; for partial usage, it is the reduced amount.
// This deliberately has no foreign key to Food, because the live Food row may
// be deleted later.
model FoodRemoval {
  id        String            @id @default(cuid())
  foodId    Int
  name      String
  amount    Float
  unit      MeasurementUnit
  expiry    String?
  storage   StorageType
  reason    FoodRemovalReason
  source    FoodRemovalSource
  createdAt DateTime          @default(now())

  @@index([name, createdAt])
  @@index([reason, createdAt])
}

enum MeasurementUnit {
  g
  kg
  l
  ml
  unit
}

enum StorageType {
  fridge
  freezer
  pantry
  spices
}

model ShoppingItem {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Conversation {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  action         Json?
  model          String?
  inputTokens    Int?
  cachedInputTokens Int?
  outputTokens   Int?
  reasoningTokens Int?
  totalTokens    Int?
  estimatedCostUsd Float?
  actionStatus   ChatActionStatus @default(pending)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ChatRole {
  user
  assistant
}

enum FoodRemovalReason {
  consumed
  discarded
  accidental_entry
}

enum FoodRemovalSource {
  manual
  assistant
}

enum ChatActionStatus {
  pending
  confirmed
  cancelled
}
